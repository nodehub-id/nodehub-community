# ===========================================
# Required
# ===========================================

# Database connection string
DATABASE_URL=postgresql://nodehub:nodehub@localhost:5432/nodehub

# Session encryption secret (32+ characters recommended)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here-minimum-32-characters-long

# ===========================================
# Default Admin (for first-time setup)
# These are used to create the initial admin user when no users exist
# ===========================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password-here

# ===========================================
# Optional OAuth Providers (for additional login options)
# ===========================================
# GitHub OAuth (optional)
# GITHUB_ID=your-github-client-id
# GITHUB_SECRET=your-github-client-secret

# ===========================================
# MODEL PROVIDER API KEYS
# These are used for LLM chat/completion requests
# Can also be configured via the dashboard
# ===========================================

# OpenAI (for GPT-4o, GPT-4o-mini models)
# MODEL_OPENAI_API_KEY=sk-...

# Anthropic (for Claude models)
# MODEL_ANTHROPIC_API_KEY=sk-ant-...

# Google (for Gemini models)
# MODEL_GOOGLE_API_KEY=...

# Groq (for fast inference with Llama, Mixtral)
# MODEL_GROQ_API_KEY=gsk_...

# Ollama (for local/self-hosted models)
# MODEL_OLLAMA_URL=http://localhost:11434

# ===========================================
# EMBEDDING PROVIDER CONFIGURATION
# Used for generating embeddings for semantic caching
# ===========================================

# Embedding provider: 'local' | 'ollama' | 'huggingface-tei' | 'openai'
# Default: 'local' (no API key or external service required)
EMBEDDING_PROVIDER=local

# Local Transformers (default, free, no server needed)
# Uses @xenova/transformers to run embeddings in-process
# First request may be slow (~30s) as it downloads the model
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Ollama Embeddings (self-hosted, free)
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_OLLAMA_URL=http://localhost:11434
# EMBEDDING_OLLAMA_MODEL=nomic-embed-text

# HuggingFace TEI Embeddings (self-hosted, free)
# EMBEDDING_PROVIDER=huggingface-tei
# EMBEDDING_TEI_URL=http://localhost:8080
# EMBEDDING_TEI_MODEL=BAAI/bge-small-en-v1.5

# OpenAI Embeddings (cloud, requires API key)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_OPENAI_API_KEY=sk-...
# EMBEDDING_OPENAI_MODEL=text-embedding-3-small

# ===========================================
# Optional Configuration
# ===========================================

# Public URL of the app (required for OAuth callbacks in production)
# NEXTAUTH_URL=http://localhost:3000

# Log level (debug, info, warn, error)
# LOG_LEVEL=info

# Server port (default: 3000)
# PORT=3000

# Enable request logging (disabled by default for privacy)
# ENABLE_REQUEST_LOGGING=false

# ===========================================
# Data Retention & Cleanup
# ===========================================

# Analytics retention in days (Community Edition default: 7)
# ANALYTICS_RETENTION_DAYS=7

# Enable automatic cleanup (default: true)
# CLEANUP_ENABLED=true

# Cleanup probability per request (default: 0.01 = 1%)
# Higher values = more frequent cleanup but slightly more overhead
# CLEANUP_PROBABILITY=0.01
